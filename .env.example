# Copy this file to .env and fill it in. Never commit .env to git.

# --- Telegram (create TWO bots with @BotFather) ---
AI_BOT_TOKEN=
WATCHDOG_BOT_TOKEN=
# Send /myid to the watchdog bot, then paste the number here
ADMIN_CHAT_ID=

# --- AI provider: any OpenAI-compatible API ---
# Google Gemini (has a free tier, key from https://aistudio.google.com):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Copy a current model name from the provider's docs (e.g. a "flash" model for Gemini)
AI_MODEL=
AI_API_KEY=
# Other options: OpenAI -> leave AI_BASE_URL empty; Groq -> https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MIN=5

# --- AI bot ---
# Heartbeat file: leave this commented out. Defaults to ./data/ai-bot.heartbeat locally;
# on the server ai-bot.service sets /var/lib/ai-bot/heartbeat (a value here would override it).
# AI_BOT_HEARTBEAT_FILE=
HEARTBEAT_INTERVAL=30

# --- Watchdog (Linux + systemd only) ---
WATCHED_SERVICES=ai-bot
# name=path pairs, comma-separated
HEARTBEAT_FILES=ai-bot=/var/lib/ai-bot/heartbeat
CHECK_INTERVAL=60
HEARTBEAT_MAX_AGE=120
AUTO_RESTART_ON_STALE=true
AUTO_RESTART_COOLDOWN=600
DAILY_REPORT_TIME=09:00
TIMEZONE=Asia/Jakarta

LOG_LEVEL=INFO
